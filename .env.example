# ==============================================================================
# REPLAY: PERSONAL MEMORY ENGINE - LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MongoDB Configuration
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=replay_secure_password_2026
SPRING_DATA_MONGODB_URI=mongodb://admin:replay_secure_password_2026@localhost:27017/replay_db?authSource=admin

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=replay

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replay_redis_password

# Artificial Intelligence (Gemini API)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_TEXT=gemini-1.5-flash
GEMINI_MODEL_VISION=gemini-1.5-flash
GEMINI_MODEL_EMBEDDING=text-embedding-004

# Security & JWT (Secret must be at least 256 bits / 32 bytes)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000        # 24 Hours
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 Days

# Local Storage Path for User Uploads
STORAGE_PATH=./storage

# Async Job & Worker Configuration
ASYNC_CORE_POOL_SIZE=4
ASYNC_MAX_POOL_SIZE=8
ASYNC_QUEUE_CAPACITY=100
